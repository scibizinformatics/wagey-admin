# Reference copy of the environment this app is built against. Committed on
# purpose; the real `.env` is git-ignored.
#
# IMPORTANT: this project builds with @quasar/app-webpack, not Vite, so nothing
# here is auto-loaded and no value below is read at runtime. `quasar.config.js`
# bakes the two settings in at *build* time through webpack.DefinePlugin, keyed
# off `process.env.*` as read on the machine running the build. Editing this
# file — or `.env` — therefore changes nothing on its own.
#
# To change either value, set a real environment variable before building:
#
#   API_BASE_URL=https://staging.wageyapp.com VITE_WS_URL=wss://... npm run build
#
# or edit the fallback in quasar.config.js.

# Django REST backend. Falls back to https://staging.wageyapp.com in a
# production build; in dev it is left empty so devServer.proxy handles the
# API path prefixes instead.
API_BASE_URL=https://staging.wageyapp.com

# Notifications WebSocket, read by src/composables/useWebSocket.js. Falls back
# to the page's own origin when unset.
VITE_WS_URL=wss://staging.wageyapp.com
